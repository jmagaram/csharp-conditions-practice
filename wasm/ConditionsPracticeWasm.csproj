<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn ships compiler messages in many languages; keep English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Publishing "trims" .NET code the app doesn't use, to make the download smaller. Student
    code can call methods this app never uses itself (Math.Max, Console.WriteLine(int)...),
    so StudentApi.xml tells the trimmer to keep those types whole.
  -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="StudentApi.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!--
    The C# compiler needs "reference assemblies" that describe the .NET types students
    can use (int, bool, Math, Console...). A WebAssembly app has no DLL files on disk,
    so embed the ones from the .NET targeting pack inside this app.
  -->
  <Target Name="EmbedStudentReferenceAssemblies" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <_StudentRef Include="@(Reference)" Condition="'%(Filename)' == 'System.Runtime' Or '%(Filename)' == 'System.Console'" />
      <EmbeddedResource Include="@(_StudentRef->'%(FullPath)')" LogicalName="ref/%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
    <Error Condition="'@(_StudentRef->Count())' != '2'" Text="Could not find System.Runtime.dll and System.Console.dll reference assemblies to embed." />
  </Target>

</Project>
